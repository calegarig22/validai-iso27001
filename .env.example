# Postgres (Neon). As tabelas são criadas no primeiro uso.
DATABASE_URL=postgresql://usuario:senha@host-exemplo/neondb?sslmode=require

# Senha do Painel Admin (use uma senha longa e aleatória)
APP_SENHA=troque-esta-senha

# Opcional: chave reserva do Gemini, usada se nenhuma for salva no Painel Admin
GEMINI_API_KEY=
